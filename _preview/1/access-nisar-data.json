lSource":"ASF_support_logo.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Contact ASF User Support: ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"NYvA6xky40"},{"type":"link","url":"mailto:uso@asf.alaska.edu","children":[{"type":"text","value":"uso@asf.alaska.edu","key":"PaVgARe140"}],"urlSource":"mailto:uso@asf.alaska.edu","key":"uM61xtA8bP"}],"key":"VA8k8ktAx3"}],"key":"fBUiaURP4z"}],"enumerator":"2","key":"aLElO8TCAs"}],"key":"e15ej6AcNt"},{"type":"thematicBreak","key":"agkEYgJ7xC"},{"type":"heading","depth":2,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"0. Initialize the user-defined variables for this notebook","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"Z1klZPMkR7"}],"identifier":"id-0-initialize-the-user-defined-variables-for-this-notebook","label":"0. Initialize the user-defined variables for this notebook","html_id":"id-0-initialize-the-user-defined-variables-for-this-notebook","implicit":true,"key":"qLKn405gpe"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Update the variables below to initalize your NISAR GUNW search parameters and create a directory in which to store your data.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"JWKSfR7D5X"}],"key":"X0YxUizJ27"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Use ","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"Fiye5fqASU"},{"type":"link","url":"https://nisar-docs.asf.alaska.edu/vertex/","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Vertex","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"g83P7QjjjA"}],"urlSource":"https://nisar-docs.asf.alaska.edu/vertex/","key":"STai7VkpjC"},{"type":"text","value":" to preview the data you wish to access and identify the values to use for the search parameters below.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"HnESpi1f8D"}],"key":"YUHFzEkwmf"}],"identifier":"0b1ffe80-aa7b-4696-9cb3-666766590d64-intro","html_id":"0b1ffe80-aa7b-4696-9cb3-666766590d64-intro","key":"t9u3Zq0NBm"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from datetime import datetime\nfrom pathlib import Path\n\nstart_date = datetime(2025, 5, 22)\nend_date = datetime(2028, 12, 5)\n\n# POINT or POLYGON as WKT (well-known-text)\nsearch_aoi = \"POLYGON((-90.3933 29.1394,-89.4273 29.1394,-89.4273 30.0661,-90.3933 30.0661,-90.3933 29.1394))\" # Tip: Copy/paste WKT from a Vertex search\n\nframe = 74\nrelativeOrbit = 156\n\n# Create a directory in which to store your data \ndata_dir = Path.cwd() / \"MintPy_example_GUNW_data\"\ndata_dir.mkdir(exist_ok=True)\nprint(f'data_dir: {data_dir}')","key":"oijVK7rMXk"},{"type":"outputs","id":"xNl-jrE7plz3tal5FHO6f","children":[],"key":"YK55sqJTaX"}],"identifier":"b255c6ce-039e-479a-b931-d22c92538073","html_id":"b255c6ce-039e-479a-b931-d22c92538073","key":"IjywjxCJyE"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"KKjj5kOCzV"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"1. Search and download NISAR GUNW Data","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VJgGV5vRzL"}],"identifier":"id-1-search-and-download-nisar-gunw-data","label":"1. Search and download NISAR GUNW Data","html_id":"id-1-search-and-download-nisar-gunw-data","implicit":true,"key":"bpf2Hs6O1h"},{"type":"heading","depth":3,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"1a. Search for NISAR GUNW data with asf_search","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"NX8YihZuxJ"}],"identifier":"id-1a-search-for-nisar-gunw-data-with-asf-search","label":"1a. Search for NISAR GUNW data with asf_search","html_id":"id-1a-search-for-nisar-gunw-data-with-asf-search","implicit":true,"key":"GYqwWBTixX"}],"identifier":"ef9dd685-8f46-4692-9e4c-b6a248f356d0","html_id":"ef9dd685-8f46-4692-9e4c-b6a248f356d0","key":"VD2RkiDHWI"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import asf_search as asf\nfrom getpass import getpass\n\nsession = asf.ASFSession()\nsession.auth_with_creds(input('EDL Username'), getpass('EDL Password'))\n\nopts=asf.ASFSearchOptions(**{\n    \"maxResults\": 250,\n    \"intersectsWith\": search_aoi,\n    \"start\": start_date,\n    \"end\": end_date,\n    \"processingLevel\": [\n        \"GUNW\"\n    ],\n    \"dataset\": [\n        \"NISAR\"\n    ],\n    \"productionConfiguration\": [\n        \"PR\"\n    ],\n    \"dataMaturity\" : \"PROVISIONAL\",\n    'session': session,\n    \"frame\": frame,\n    \"relativeOrbit\": relativeOrbit,\n})\n\npattern = r'^(?!.*QA_STATS).*' # regex to remove static data files from results\nresponse = asf.search(opts=opts)\nhdf5_urls = response.find_urls(extension='.h5', pattern=pattern, directAccess=False)\nhdf5_urls","key":"rqgUC4tKMP"},{"type":"outputs","id":"fsdcE8FKGiOtfA63tSL1f","children":[],"key":"fwCHcRNiyH"}],"identifier":"ed826c44-2c86-4674-8016-23b639bb3b20","html_id":"ed826c44-2c86-4674-8016-23b639bb3b20","key":"PfHTpDqjp2"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1b. Retain only the latest GUNW product releases","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QQU1vuImsa"}],"identifier":"id-1b-retain-only-the-latest-gunw-product-releases","label":"1b. Retain only the latest GUNW product releases","html_id":"id-1b-retain-only-the-latest-gunw-product-releases","implicit":true,"key":"vGjO49Cj1E"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"NISAR products are occasionaly re-released using the same processor version for a variety of possible reasons. These products will maintain the same CRID and have an incremented CTR. See ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"tojtQUOsoW"},{"type":"link","url":"https://nisar-docs.asf.alaska.edu/naming-conventions/","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"NISAR naming convention documentation","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PjiYjNHgye"}],"urlSource":"https://nisar-docs.asf.alaska.edu/naming-conventions/","key":"Q9Uu4YmHON"},{"type":"text","value":" for details.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"eHBlFumgxr"}],"key":"UcMvsJyWut"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The cell below retains only the most recent release of each NISAR GUNW.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"rpc3kXsJ4r"}],"key":"HKeY0m2OwK"}],"identifier":"42d69c3b-5989-4afd-9ac2-fb090402fec8","html_id":"42d69c3b-5989-4afd-9ac2-fb090402fec8","key":"aJCwPu4MiA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import re\n\ndef keep_latest_gunw(urls):\n    latest = {}\n\n    for url in urls:\n        dates = re.findall(r\"\\d{8}T\\d{6}\", url)\n        pair = (dates[0][:8], dates[2][:8])\n        version = int(re.search(r\"_(\\d{3})\\.h5\", url).group(1))\n\n        if pair not in latest or version > latest[pair][0]:\n            latest[pair] = (version, url)\n\n    return [url for version, url in latest.values()]\n\nkeep_latest_gunw(hdf5_urls)","key":"tYUHTquQNv"},{"type":"outputs","id":"2yRgIpG0A1i6jksbJSoUR","children":[],"key":"Z1xbniEKhx"}],"identifier":"b5560d1b-4916-4e76-b301-67190beb2602","html_id":"b5560d1b-4916-4e76-b301-67190beb2602","key":"RH2ZBbXFck"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1c. Download the NISAR GUNWs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ewYG8crV1b"}],"identifier":"id-1c-download-the-nisar-gunws","label":"1c. Download the NISAR GUNWs","html_id":"id-1c-download-the-nisar-gunws","implicit":true,"key":"UQ6M41QgBS"}],"identifier":"a67d3e90-d423-4d74-b74d-0534f2bf2b15","html_id":"a67d3e90-d423-4d74-b74d-0534f2bf2b15","key":"Om33BBSPwm"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"asf.download_urls(hdf5_urls, data_dir, session=session)","key":"b8KlsgYKYn"},{"type":"outputs","id":"ypRnV9q8mc3fDJvzRnp1n","children":[],"key":"ACnEskOeVQ"}],"identifier":"158a6928-4088-40c8-95af-7b6437efa16b","html_id":"158a6928-4088-40c8-95af-7b6437efa16b","key":"Ilt7PlPNl4"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"xF2CIuoQNj"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"2. Identify a GUNW’s bounding box and EPSG","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"eQvJqLewRy"}],"identifier":"id-2-identify-a-gunws-bounding-box-and-epsg","label":"2. Identify a GUNW’s bounding box and EPSG","html_id":"id-2-identify-a-gunws-bounding-box-and-epsg","implicit":true,"key":"HYrhpAY1fd"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"This information will be used for subsetting and reprojecting","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"FdbAwClxne"}],"key":"fqhVMtiSKC"}],"identifier":"9e067335-9a11-4cdd-8098-4978567e314c","html_id":"9e067335-9a11-4cdd-8098-4978567e314c","key":"GBZ1ji96PZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from shapely import wkt\nimport h5py\n\ngunw_paths = list(data_dir.glob(\"*GUNW*.h5\"))\n\nwith h5py.File(gunw_paths[0]) as f:\n    polygon = wkt.loads(f[\"/science/LSAR/identification/boundingPolygon\"][()].decode())\n    epsg =  f[\"/science/LSAR/GUNW/grids/frequencyA/unwrappedInterferogram/HH/projection\"][()].item()\n\nbbox = polygon.bounds  # west, south, east, north\n\nprint(f\"bbox: {bbox}\")\nprint(f\"EPSG: {epsg}\")","key":"vi8maJyPxJ"},{"type":"outputs","id":"HdtOfe-Ga3ebEsepv-Gaz","children":[],"key":"chlRNyV4CW"}],"identifier":"a2331463-1a7e-4e7f-a00f-848cf62fd395","html_id":"a2331463-1a7e-4e7f-a00f-848cf62fd395","key":"JRTUZJGb99"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"BQroll2roc"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"3 (Optional) Subset NISAR GUNWs to an AOI","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"B4RcMxyftS"}],"identifier":"id-3-optional-subset-nisar-gunws-to-an-aoi","label":"3 (Optional) Subset NISAR GUNWs to an AOI","html_id":"id-3-optional-subset-nisar-gunws-to-an-aoi","implicit":true,"key":"Ku8D8ptEM0"},{"type":"heading","depth":3,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"3a. Identify an Area of Interest (AOI)","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Q90cc6OaZY"}],"identifier":"id-3a-identify-an-area-of-interest-aoi","label":"3a. Identify an Area of Interest (AOI)","html_id":"id-3a-identify-an-area-of-interest-aoi","implicit":true,"key":"Epd8ygHz3M"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Use the interactive map below to generate well-known-text (WKT) of your AOI. Copy the wkt and update the area_of_interest variable in the next code cell.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"fuxBYgQuuQ"}],"key":"PowDoxNhk5"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Try refreshing the browser tab if you have issues displaying the interactive map.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"d6eTCtkGwA"}],"key":"BsG5PJIDwG"}],"identifier":"c187a201-edd3-4082-8d9e-7f6319b9824d","html_id":"c187a201-edd3-4082-8d9e-7f6319b9824d","key":"pib8iO2Vve"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nimport sys\nproject_root = Path.cwd().parent\nsys.path.insert(0, str(project_root))\n\nfrom util.wkt import rectangular_aoi_select, rectangular_wkt_bounds\n\naoi_map = rectangular_aoi_select(bbox)\n\nprint(\"Click the ■ button to select an area of interest\\n\") \ndisplay(aoi_map[\"map\"])","key":"yI6y2nT5Vm"},{"type":"outputs","id":"fW4zXQNUxr5kvwaBR9ZpN","children":[],"key":"aDPdpoGPIY"}],"identifier":"de6f861c-7be2-4504-bbd5-cfd77027f269","html_id":"de6f861c-7be2-4504-bbd5-cfd77027f269","key":"ysS7uc9yOH"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3b. Set the WKT for your subset AOI","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eOlSnvnnEm"}],"identifier":"id-3b-set-the-wkt-for-your-subset-aoi","label":"3b. Set the WKT for your subset AOI","html_id":"id-3b-set-the-wkt-for-your-subset-aoi","implicit":true,"key":"xX7lOq60Df"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Replace the WKT string below with the subset AOI you created with the interactive map in Step 3a.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"iZOiR3zraW"}],"key":"NqyvtY83GV"}],"identifier":"0fc3e9ec-13ca-43be-bd4f-781b37b952a7","html_id":"0fc3e9ec-13ca-43be-bd4f-781b37b952a7","key":"QAU2LHSLqx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"subset_aoi = \"POLYGON((-91.164122 29.117675, -90.493956 29.117675, -90.493956 29.457834, -91.164122 29.457834, -91.164122 29.117675))\"","key":"LfSi4hCVsv"},{"type":"outputs","id":"t294kNEjVMIfs8h9VMAhE","children":[],"key":"DIBs5F5Wmj"}],"identifier":"388bb843-c7b1-48d3-be85-503e008ac7cc","html_id":"388bb843-c7b1-48d3-be85-503e008ac7cc","key":"LZHyRnmGCz"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3c. Subset the GUNWs to your AOI and delete the unsubset data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"N6QrsgUKsl"}],"identifier":"id-3c-subset-the-gunws-to-your-aoi-and-delete-the-unsubset-data","label":"3c. Subset the GUNWs to your AOI and delete the unsubset data","html_id":"id-3c-subset-the-gunws-to-your-aoi-and-delete-the-unsubset-data","implicit":true,"key":"RV3XN6kyep"}],"identifier":"dc235023-7215-43f0-a150-8bf2144b3a1a","html_id":"dc235023-7215-43f0-a150-8bf2144b3a1a","key":"gTQQGlqCwT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from osgeo import gdal\nfrom util.subset_gunw import subset_gunw\nfrom tqdm.notebook import tqdm\n\nfor gunw_path in tqdm(gunw_paths):\n    output_path = f\"{gunw_path.parent}/{gunw_path.stem}_subset.h5\"\n    subset_gunw(gunw_path, output_path, subset_aoi)\n\n    gunw_path.unlink()    ","key":"kCF0JVSfpo"},{"type":"outputs","id":"sN0RNK47WmuH7daJcrvOV","children":[],"key":"zsKVY9XqW1"}],"identifier":"e8105f37-36e2-4807-9dd4-7a59def32047","html_id":"e8105f37-36e2-4807-9dd4-7a59def32047","key":"NJV1tQVKBk"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3d. Update the bbox for the subset GUNWs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"P69DuQDN2N"}],"identifier":"id-3d-update-the-bbox-for-the-subset-gunws","label":"3d. Update the bbox for the subset GUNWs","html_id":"id-3d-update-the-bbox-for-the-subset-gunws","implicit":true,"key":"TCdOhdydpO"}],"identifier":"09accb30-d05a-42a0-a967-5dc696041853","html_id":"09accb30-d05a-42a0-a967-5dc696041853","key":"WokZ1fnPd7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from shapely import wkt\nimport h5py\n\ngunw_paths = list(data_dir.glob(\"*GUNW*.h5\"))\n\nwith h5py.File(gunw_paths[0]) as f:\n    polygon = wkt.loads(f[\"/science/LSAR/identification/boundingPolygon\"][()].decode())\n\nbbox = polygon.bounds  # west, south, east, north\n\nprint(f\"bbox: {bbox}\")","key":"pkudpCvGYz"},{"type":"outputs","id":"rsI117ST4pmSQHhV_4Aiu","children":[],"key":"V8zR5sXHaZ"}],"identifier":"2c8241b3-7681-4f39-909b-392ae1f80f88","html_id":"2c8241b3-7681-4f39-909b-392ae1f80f88","key":"qLk6EZMRBd"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"q7OYvIGID7"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"4. (Optional) Inspect one of the GUNWs with Xarray","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"sz7lfKQJt4"}],"identifier":"id-4-optional-inspect-one-of-the-gunws-with-xarray","label":"4. (Optional) Inspect one of the GUNWs with Xarray","html_id":"id-4-optional-inspect-one-of-the-gunws-with-xarray","implicit":true,"key":"fTNyXov7KS"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Xarray provides a rich interactive HTML UI for exploring HDF5 data structures in a Jupyter Notebook.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"i5RZaDMh6G"}],"key":"j1R5LrLP46"}],"identifier":"4ac08d89-b16c-4843-a748-0b48ce57d6bb","html_id":"4ac08d89-b16c-4843-a748-0b48ce57d6bb","key":"Ok6cYI4K9S"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"import xarray as xr\n\ndt = xr.open_datatree(\n        open(gunw_paths[0], \"rb\"),\n        engine=\"h5netcdf\",\n        decode_timedelta=False,\n        phony_dims=\"access\",\n        chunks=\"auto\",\n)\ndisplay(dt)","key":"guYrAjxkod"},{"type":"outputs","id":"e5OuwCQNJ3usQmDowI6Uk","children":[],"key":"ywOcQJXt7c"}],"identifier":"1f5611cd-b5f8-4158-8408-b19b6a0940e4","html_id":"1f5611cd-b5f8-4158-8408-b19b6a0940e4","key":"TRwen9PSzV"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"Fe4wymy0xN"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"5. Download and reproject the Modified Copernicus DEM for NISAR","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"X7hd3LD75a"}],"identifier":"id-5-download-and-reproject-the-modified-copernicus-dem-for-nisar","label":"5. Download and reproject the Modified Copernicus DEM for NISAR","html_id":"id-5-download-and-reproject-the-modified-copernicus-dem-for-nisar","implicit":true,"key":"QxlyAOYxcf"},{"type":"heading","depth":3,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"5a. Download a subset Modified Copernicus DEM for NISAR with sardem","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"X9o7ONVAjG"}],"identifier":"id-5a-download-a-subset-modified-copernicus-dem-for-nisar-with-sardem","label":"5a. Download a subset Modified Copernicus DEM for NISAR with sardem","html_id":"id-5a-download-a-subset-modified-copernicus-dem-for-nisar-with-sardem","implicit":true,"key":"EA51v1emGx"}],"identifier":"db659e52-0493-4feb-8e7b-cff6f5be820a","html_id":"db659e52-0493-4feb-8e7b-cff6f5be820a","key":"vmy5nqpySJ"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"import sardem.dem as dem\n\ndem_4326 = data_dir / \"DEM.tif\"\n\ndem.main(\n    output_name=dem_4326,\n    bbox=bbox,\n    data_source=\"NISAR\"\n)","key":"OGBXKKTLHV"},{"type":"outputs","id":"EtPcpQG9k6ktu13aL5bDO","children":[],"key":"fG9JATwwpz"}],"identifier":"8276aa20-2fee-4559-895b-3ee906bdaffd","html_id":"8276aa20-2fee-4559-895b-3ee906bdaffd","key":"EqdInBIPy1"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5b. Reproject DEM to GUNW EPSG","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cre54KYFZ5"}],"identifier":"id-5b-reproject-dem-to-gunw-epsg","label":"5b. Reproject DEM to GUNW EPSG","html_id":"id-5b-reproject-dem-to-gunw-epsg","implicit":true,"key":"F9wMYJUqnx"}],"identifier":"096e0608-926d-49f8-9bfd-6e1a46ace39c","html_id":"096e0608-926d-49f8-9bfd-6e1a46ace39c","key":"dXYgFVWtgh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from osgeo import gdal\ngdal.UseExceptions()\n\ninput_raster = dem_4326\noutput_raster = data_dir / f\"DEM_{epsg}.tif\"\ntarget_crs = f\"EPSG:{epsg}\"\n\nwarp_options = gdal.Warp(output_raster, input_raster, dstSRS=target_crs)\nwarp_options = None\n\ndem_4326.unlink()","key":"JHuqyHf4Ql"},{"type":"outputs","id":"c2M7qczulnhywutD1bsQP","children":[],"key":"YqCJZd4rgS"}],"identifier":"644077be-abfd-4543-a7ff-45071805bc73","html_id":"644077be-abfd-4543-a7ff-45071805bc73","key":"U9CJZhDZ3y"}],"key":"oM1c0KqsdM"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Search and Stream NISAR Data with asf_search","url":"/search-stream-nisar-asf-search","group":"Imported Notebooks"}}},"domain":"http://localhost:3000"}